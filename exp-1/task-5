#include <iostream>
using namespace std;

int main() {
    double n = 0.5;

    if (n < 0)
        cout << "n is negative (n < 0)" << endl;
    else if (n >= 0 && n <= 1)
        cout << "n is between 0 and 1 (0 <= n <= 1)" << endl;
    else
        cout << "n is greater than 1 (n > 1)" << endl;

    return 0;
}
