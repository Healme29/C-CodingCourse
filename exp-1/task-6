#include <iostream>
using namespace std;

int main() {
    int score = 88;

    switch (score / 10) {
        case 10:
        case 9:
            cout << "Grade: A (score >= 90)" << endl;
            break;
        case 8:
            cout << "Grade: B (80 <= score < 90)" << endl;
            break;
        case 7:
            cout << "Grade: C (70 <= score < 80)" << endl;
            break;
        case 6:
            cout << "Grade: D (60 <= score < 70)" << endl;
            break;
        default:
            cout << "Grade: F (score < 60)" << endl;
    }

    return 0;
}
