#include <iostream>
using namespace std;

class Animal {
public:
    virtual void makeSound() = 0; 
    virtual ~Animal() {}          
};

class Dog : public Animal {
public:
    void makeSound()  {
        cout << "Dog says: Woof!" << endl;
    }
};

class Cat : public Animal {
public:
    void makeSound()  {
        cout << "Cat says: Meow!" << endl;
    }
};

class Bird : public Animal {
public:
    void makeSound()  {
        cout << "Bird says: Chirp!" << endl;
    }
};

int main() {
    Animal* animals[3];
    animals[0] = new Dog();
    animals[1] = new Cat();
    animals[2] = new Bird();

    cout << "=== Animal Sound Simulator ===" << endl;
    for (int i = 0; i < 3; i++) {
        animals[i]->makeSound();
    }

    for (int i = 0; i < 3; i++) {
        delete animals[i];
    }

    return 0;
} 
