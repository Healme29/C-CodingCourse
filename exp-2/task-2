#include <iostream>
using namespace std;

int main() {
    double sum = 0.0;
    double a = 2.0, b = 1.0;
    int sign = 1;

    for (int i = 0; i < 1000; i++) {
        sum += sign * (a / b);

        double next = a + b;
        b = a;
        a = next;

        sign = -sign;
    }

    cout << "S = " << sum << endl;

    return 0;
}
