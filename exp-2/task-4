#include <iostream>
using namespace std;

int main() {
    cout << "Prime numbers in [2, 1000]:" << endl;

    int count = 0;
    for (int n = 2; n <= 1000; n++) {
        bool isPrime = true;
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                isPrime = false;
                break;
            }
        }
        if (isPrime) {
            cout << n;
            count++;
            if (count % 10 == 0)
                cout << endl;
            else
                cout << "\t";
        }
    }

    cout << endl;
    cout << "Total prime numbers: " << count << endl;

    return 0;
}
