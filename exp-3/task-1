#include <iostream>
using namespace std;

bool judgePrime(int x) {
    if (x < 2) return false;
    if (x == 2) return true;
    if (x % 2 == 0) return false;

    for (int i = 3; i * i <= x; i += 2) {
        if (x % i == 0) return false;
    }
    return true;
}

int main() {
    cout << " Prime Number Checker " << endl;
    cout << endl;

    cout << "1  is " << (judgePrime(1)  ? "Prime" : "Not Prime") << endl;
    cout << "2  is " << (judgePrime(2)  ? "Prime" : "Not Prime") << endl;
    cout << "3  is " << (judgePrime(3)  ? "Prime" : "Not Prime") << endl;
    cout << "4  is " << (judgePrime(4)  ? "Prime" : "Not Prime") << endl;
    cout << "5  is " << (judgePrime(5)  ? "Prime" : "Not Prime") << endl;
    cout << "10 is " << (judgePrime(10) ? "Prime" : "Not Prime") << endl;
    cout << "13 is " << (judgePrime(13) ? "Prime" : "Not Prime") << endl;
    cout << "15 is " << (judgePrime(15) ? "Prime" : "Not Prime") << endl;

    return 0;
}
