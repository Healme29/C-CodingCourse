#include <iostream>
#include <cstring>
#include <cctype>
using namespace std;

int main() {
    char str[200];
    int letters = 0, digits = 0, others = 0;

    cout << "Enter a string: ";
    cin.getline(str, 200);

    for (int i = 0; i < strlen(str); i++) {
        if (isalpha(str[i]))
            letters++;
        else if (isdigit(str[i]))
            digits++;
        else
            others++;
    }

    cout << "English letters (case-insensitive count): " << letters << endl;
    cout << "Digits: " << digits << endl;
    cout << "Other characters: " << others << endl;

    return 0;
}
